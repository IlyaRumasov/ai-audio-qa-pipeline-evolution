    },
    {
      "id": "5e75dffa-c920-52b8-8cee-fec292366572",
      "name": "Vertex: створити задачу",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        290,
        290
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "method": "POST",
        "url": "=https://{{ $('Вхід').first().json.gcp_location }}-aiplatform.googleapis.com/v1/projects/{{ $('Вхід').first().json.gcp_project }}/locations/{{ $('Вхід').first().json.gcp_location }}/batchPredictionJobs",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ displayName: $('Вхід').first().json.display_name, model: 'publishers/google/models/' + $('Вхід').first().json.model, inputConfig: { instancesFormat: 'jsonl', gcsSource: { uris: ['gs://' + $('Вхід').first().json.bucket + '/' + $('Вхід').first().json.input_object] } }, outputConfig: { predictionsFormat: 'jsonl', gcsDestination: { outputUriPrefix: 'gs://' + $('Вхід').first().json.bucket + '/' + $('Вхід').first().json.output_prefix } } }) }}",
        "options": {}
      },
      "credentials": {
        "googleApi": {
          "id": "<GCP_SA_CRED_ID>",
          "name": "Google Service Account (GCS + Vertex AI)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000
    },
    {
      "id": "ed8943c6-d8fb-5f21-981e-d80c05b5a30b",
      "name": "Чекати N хвилин",
      "type": "n8n-nodes-base.wait",
      "typeVersion": 1.1,
      "position": [
        510,
        290
      ],
      "parameters": {
        "amount": "={{ $('Вхід').first().json.poll_minutes }}",
        "unit": "minutes"
      },
      "webhookId": "fe714005-ffe6-5479-9446-1b181c0a43af"
    },
    {
      "id": "a1dbe1f4-eba2-5744-80f8-e386ea3a9ea5",
      "name": "Vertex: стан задачі",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        730,
        290
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "url": "=https://{{ $('Вхід').first().json.gcp_location }}-aiplatform.googleapis.com/v1/{{ $('Vertex: створити задачу').first().json.name }}",
        "options": {}
      },
      "credentials": {
        "googleApi": {
          "id": "<GCP_SA_CRED_ID>",
          "name": "Google Service Account (GCS + Vertex AI)"
        }
      },
      "retryOnFail": true,
      "maxTries": 5,
      "waitBetweenTries": 30000
    },
    {
      "id": "15fa7c79-57fa-5ae6-ad8c-92fee3149c72",
      "name": "Стан задачі",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        950,
        290
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const inp = $('Вхід').first().json;\nconst job = $input.first().json;\nconst created = $('Vertex: створити задачу').first().json;\nconst state = job.state || '';\nconst hours = (Date.now() - new Date(job.createTime || created.createTime).getTime()) / 3.6e6;\nlet phase = 'wait';\nif (['JOB_STATE_SUCCEEDED', 'JOB_STATE_PARTIALLY_SUCCEEDED'].includes(state)) phase = 'done';\nelse if (['JOB_STATE_FAILED', 'JOB_STATE_CANCELLED', 'JOB_STATE_CANCELLING', 'JOB_STATE_EXPIRED'].includes(state)) phase = 'failed';\nelse if (hours > Number(inp.max_wait_hours)) phase = 'timeout';\nconst outDir = (job.outputInfo || {}).gcsOutputDirectory || '';\nreturn [{ json: { stage: String(inp.stage), phase, state, hours: Math.round(hours * 10) / 10, job_name: job.name || created.name,\n  error: job.error ? (job.error.message || JSON.stringify(job.error)) : '',\n  out_prefix: outDir.replace('gs://' + inp.bucket + '/', '').replace(/\\/?$/, '/'), stats: job.completionStats || {} } }];\n"
      }
    },
    {
      "id": "4545a8f9-7818-5750-835d-bf72fb3771a7",
      "name": "Готово?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1170,
        290
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "dd648046-8039-5062-812c-3176da9c1003",
              "leftValue": "={{ $json.phase }}",
              "rightValue": "done",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
