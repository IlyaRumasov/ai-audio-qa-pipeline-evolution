              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "a900374b-276f-5f73-ac00-5f2de1d627ba",
      "name": "GCS: список результатів",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1460,
        290
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "url": "=https://storage.googleapis.com/storage/v1/b/{{ $('Вхід').first().json.bucket }}/o",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "prefix",
              "value": "={{ $json.out_prefix }}"
            },
            {
              "name": "fields",
              "value": "items(name),nextPageToken"
            }
          ]
        },
        "options": {
          "pagination": {
            "pagination": {
              "paginationMode": "updateAParameterInEachRequest",
              "parameters": {
                "parameters": [
                  {
                    "type": "qs",
                    "name": "pageToken",
                    "value": "={{ $response.body.nextPageToken }}"
                  }
                ]
              },
              "paginationCompleteWhen": "other",
              "completeExpression": "={{ !$response.body.nextPageToken }}",
              "limitPagesFetched": true,
              "maxRequests": 1000
            }
          }
        }
      },
      "credentials": {
        "googleApi": {
          "id": "<GCP_SA_CRED_ID>",
          "name": "Google Service Account (GCS + Vertex AI)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "executeOnce": true
    },
    {
      "id": "f66ab823-17d9-5fef-938d-16721821409f",
      "name": "Файли результатів",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1680,
        290
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const out = [];\nfor (const it of $input.all()) for (const o of (it.json.items || [])) if (/\\.jsonl$/.test(o.name)) out.push({ json: { name: o.name } });\nif (!out.length) throw new Error('Vertex не записав жодного файлу результатів.');\nreturn out;\n"
      }
    },
    {
      "id": "6441e4c3-8018-52c7-95b7-48d57a9f52a8",
      "name": "GCS: завантажити результат",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1900,
        290
      ],
      "parameters": {
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "url": "=https://storage.googleapis.com/storage/v1/b/{{ $('Вхід').first().json.bucket }}/o/{{ encodeURIComponent($json.name) }}?alt=media",
        "options": {
          "timeout": 600000,
          "response": {
            "response": {
              "responseFormat": "text",
              "outputPropertyName": "data"
            }
          }
        }
      },
      "credentials": {
        "googleApi": {
          "id": "<GCP_SA_CRED_ID>",
          "name": "Google Service Account (GCS + Vertex AI)"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 10000
    },
    {
      "id": "e0c74ff6-8443-5e90-be7d-80e46906d78c",
      "name": "Результат: успіх",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2120,
        290
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const st = $('Стан задачі').first().json;\nreturn $input.all().map(i => ({ json: { ok: true, stage: st.stage, job_name: st.job_name, stats: st.stats, data: i.json.data } }));\n"
      }
    },
    {
      "id": "59ca36f2-693c-5603-a257-fd4ec72cbcbc",
      "name": "Vertex: скасувати задачу",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
