        "options": {}
      },
      "credentials": {
        "googleApi": {
          "id": "<GCP_SA_CRED_ID>",
          "name": "Google Service Account (GCS + Vertex AI)"
        }
      },
      "retryOnFail": false,
      "maxTries": 3,
      "waitBetweenTries": 10000,
      "onError": "continueRegularOutput"
    },
    {
      "id": "07adfda3-c598-57f2-a643-c28a04da1eab",
      "name": "Результат: помилка",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        510,
        760
      ],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "return [{ json: Object.assign({ ok: false }, $('Стан задачі').first().json) }];\n"
      }
    }
